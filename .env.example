# Public site URL — used in sitemap.xml, robots.txt and page metadata.
NEXT_PUBLIC_SITE_URL=https://epiquefoods.co.ke

# WhatsApp number that "Checkout via WhatsApp" and enquiry links message,
# in international format with no "+" or spaces (default: 254747175780).
NEXT_PUBLIC_WHATSAPP_NUMBER=254747175780

# Optional — enables the contact form to actually send email via Resend
# (https://resend.com). Without these, submissions are validated and logged
# server-side but no email is sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
